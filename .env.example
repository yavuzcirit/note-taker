# Backend
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-64-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BCRYPT_ROUNDS=12

# Database (docker-compose default)
DATABASE_URL=postgresql://notetaker:notetaker_pass@localhost:5432/notetaker_db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
